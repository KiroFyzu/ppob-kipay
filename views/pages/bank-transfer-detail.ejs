<%- include('../partials/head') %>

<section class="page-head">
  <a href="/transfer-bank" class="back-link">&larr; Kembali ke transfer bank</a>
  <h1>Detail Transfer Bank</h1>
</section>

<div class="card receipt">
  <div class="receipt-status <%= statusClass(bt.status) %>-bg">
    <span class="<%= statusClass(bt.status) %>"><%= statusLabel(bt.status) %></span>
    <% if (autoRefresh) { %>
      <p class="receipt-note">
        Transfer sedang diproses. Halaman ini menyegarkan otomatis setiap 5 detik.
      </p>
    <% } else if (bt.status === 'SUCCESS') { %>
      <p class="receipt-note">Saldo sudah terkirim ke rekening tujuan.</p>
    <% } else if (bt.status === 'REFUNDED') { %>
      <p class="receipt-note">Transfer gagal dan saldomu sudah dikembalikan penuh.</p>
    <% } %>
  </div>

  <dl class="receipt-list">
    <div class="receipt-row">
      <dt>Kode transaksi</dt>
      <dd class="mono"><%= bt.refId %></dd>
    </div>
    <div class="receipt-row">
      <dt>Bank tujuan</dt>
      <dd><%= bt.bankLabel %></dd>
    </div>
    <div class="receipt-row">
      <dt>Nomor rekening</dt>
      <dd class="mono"><%= bt.targetNumber %></dd>
    </div>
    <div class="receipt-row">
      <dt>Nominal</dt>
      <dd><%= rupiah(bt.nominal) %></dd>
    </div>
    <div class="receipt-row">
      <dt>Dibuat</dt>
      <dd><%= tanggal(bt.createdAt) %></dd>
    </div>
    <% if (bt.completedAt) { %>
      <div class="receipt-row">
        <dt>Selesai</dt>
        <dd><%= tanggal(bt.completedAt) %></dd>
      </div>
    <% } %>
    <% if (bt.message) { %>
      <div class="receipt-row">
        <dt>Keterangan</dt>
        <dd><%= bt.message %></dd>
      </div>
    <% } %>
    <div class="receipt-row total">
      <dt>Total dipotong dari saldo</dt>
      <dd><%= rupiah(bt.price) %></dd>
    </div>
  </dl>
</div>

<div class="detail-actions">
  <a href="/transfer-bank" class="btn btn-primary">Transfer lagi</a>
  <a href="/saldo" class="btn btn-ghost">Lihat saldo</a>
</div>

<%- include('../partials/footer') %>

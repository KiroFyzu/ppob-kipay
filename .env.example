# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
# Domain yang boleh mengakses API. Wajib diisi spesifik saat produksi.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# DATABASE_URL = connection pooler (port 6543) untuk runtime app.
# DIRECT_URL   = koneksi langsung (port 5432) khusus dipakai Prisma CLI saat
#                migrate/db push.
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter-jangan-pakai-ini"
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# TokoVoucher
# mock = tidak ada request keluar sama sekali, aman untuk pengembangan.
# live = benar-benar memotong saldo TokoVoucher. Baru pakai setelah endpoint
#        dan rumus signature di src/providers/tokovoucher/client.ts dicocokkan
#        dengan dokumentasi resmi di dashboard member.
# ---------------------------------------------------------------------------
TOKOVOUCHER_MODE=mock
TOKOVOUCHER_BASE_URL=https://api.tokovoucher.net
TOKOVOUCHER_MEMBER_CODE=
TOKOVOUCHER_SIGNATURE_KEY=
# Webhook TokoVoucher memakai formula signature YANG SAMA dengan order:
# md5(member_code:signature_key:ref_id), dikirim di header
# X-TokoVoucher-Authorization. Tidak ada secret terpisah untuk callback.

# ---------------------------------------------------------------------------
# Pricing
# sellPrice = ceil((basePrice + MARKUP_FLAT + basePrice*MARKUP_PERCENT/100)
#                  / PRICE_ROUNDING) * PRICE_ROUNDING
# ---------------------------------------------------------------------------
MARKUP_FLAT=500
MARKUP_PERCENT=1
PRICE_ROUNDING=100

# ---------------------------------------------------------------------------
# Deposit saldo
# ---------------------------------------------------------------------------
DEPOSIT_MIN_AMOUNT=10000
DEPOSIT_MAX_AMOUNT=10000000
DEPOSIT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# KiPay (kipay.id) - payment gateway QRIS untuk deposit method QRIS
# Ambil dari dashboard KiPay: /dashboard/projects -> pilih project.
# KIPAY_API_KEY   = api_key project (format qpg_...)
# KIPAY_WEBHOOK_SECRET = didapat otomatis saat mengisi Webhook URL project ke
#                        <domainmu>/api/v1/webhooks/kipay
# ---------------------------------------------------------------------------
KIPAY_BASE_URL=https://kipay.id
KIPAY_API_KEY=
KIPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transfer Bank (TokoVoucher) - docs.tokovoucher.net/bank-transfer
# ---------------------------------------------------------------------------
BANK_TRANSFER_MIN_AMOUNT=10000
BANK_TRANSFER_MAX_AMOUNT=5000000

# ---------------------------------------------------------------------------
# Batas anti-fraud
# Top up e-wallet menghasilkan saldo yang likuid, jadi batas-batas ini yang
# menahan penyalahgunaan. Longgarkan hanya kalau kamu paham risikonya.
# ---------------------------------------------------------------------------
# Maksimum transaksi ke satu nomor tujuan per 24 jam
FRAUD_MAX_TX_PER_TARGET_DAY=5
# Maksimum total rupiah ke satu nomor tujuan per 24 jam
FRAUD_MAX_AMOUNT_PER_TARGET_DAY=2000000
# Maksimum transaksi per user per jam
FRAUD_MAX_TX_PER_USER_HOUR=1000000
# Jeda minimum antar transaksi ke nomor tujuan yang sama (detik)
FRAUD_MIN_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Worker rekonsiliasi status
# ---------------------------------------------------------------------------
RECONCILE_INTERVAL_MS=15000
RECONCILE_BATCH_SIZE=25
# Setelah sekian menit masih PROCESSING, transaksi ditandai untuk review manual
RECONCILE_STUCK_AFTER_MINUTES=60
